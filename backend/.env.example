# 后端环境变量模板。复制成 .env 后填真实值，不要提交 .env。
# 云端部署时这些直接填到平台的环境变量面板里，不要打进镜像。

# Postgres 连接串。可以直接粘云厂商给的原样（postgresql://...?sslmode=require），
# config.py 会自动补上 +asyncpg 并把 sslmode 改写成 asyncpg 认识的 ssl。
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# 大模型（当前用 DeepSeek）
LLM_API_KEY=sk-xxxxxxxx
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_DISABLE=false
# 每个非管理员用户每天可调用次数，超出返回 429
LLM_DAILY_QUOTA=30

# 签发 JWT 用。线上必须换成长随机串，泄露等于所有账号被接管：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 向量后端：留空走本地 FAISS（推荐，零外部依赖）。
# 填 milvus / pinecone 才需要下面那些参数。
VECTOR_BACKEND=

# 向量化：local 需要装 requirements-embedding.txt；没装会退回哈希词袋（无语义能力）。
# 免费小内存实例建议设成 fallback 并在界面上说明 RAG 是降级的，别装作正常。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512

# 打印每条 SQL。线上保持 false
DB_ECHO=false

# 运行期数据根目录：uploads/（图片，挂 /static）、storage/resumes/（简历附件）、
# faiss.index 全在它下面。容器里不配就落到代码目录，重启即丢，所以线上必须配。
# Render / Railway 挂持久卷后指到卷的挂载点，例如 /data
DATA_DIR=/data

# 允许跨域的前端来源，逗号分隔。线上填 Vercel 域名，不要留 *
# 例：https://qicheng.vercel.app,https://qicheng.cn
CORS_ORIGINS=*
