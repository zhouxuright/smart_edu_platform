# 环境变量与密钥（含数据库密码、模型 API Key），绝不入库
.env
.env.*
!.env.example
**/.env
**/.env.*
# 模板要留：不带它别人 clone 下来不知道要配哪些变量
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 上传与生成产物
backend/uploads/
# 简历附件属于个人敏感信息，只经鉴权接口读取，不进版本库
backend/storage/
backend/server.log
*.log

# FAISS 索引与元数据：运行时生成、每小时重建，入库只会立刻过期
**/faiss.index
**/faiss_meta.json
# 本地调试用的 token 缓存
backend/mp_tok.txt
*.tmp
.tmp_*
# 模型缓存
.cache/
backend/.cache/

# Milvus 的 docker volume 数据：纯二进制，375MB，单文件最高 89MB，
# 超过 GitHub 单文件 100MB 上限的边缘，且每次起容器都会变
docker/milvus/volumes/

# 个人文档不进公开仓库（简历 PDF 含姓名、手机号、邮箱）
/*.pdf

# Node / 前端构建
node_modules/
frontend/dist/
frontend/.vite/
# 页面验收脚本的截图与测试附件
frontend/scripts/out/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 本地数据
.workbuddy-ai/

# 本地 UI 验收截图（scripts/ui_check.cjs 生成）
frontend/ui_*.png
