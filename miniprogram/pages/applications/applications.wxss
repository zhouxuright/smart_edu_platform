.stat-row {
  margin-bottom: 24rpx;
}

.picker {
  display: flex;
  align-items: center;
  min-height: 84rpx;
}

.app-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.app-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.app-main {
  flex: 1;
  min-width: 0;
}

.app-company {
  font-size: 30rpx;
  font-weight: 700;
}

.app-position {
  margin: 4rpx 0;
  font-size: 26rpx;
  color: var(--ink);
}

.tip {
  padding: 8rpx 8rpx 0;
  text-align: center;
}
