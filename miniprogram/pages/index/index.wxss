.hero {
  background: linear-gradient(135deg, #ffffff 0%, #eef5ff 100%);
}

.hero .muted {
  margin-top: 8rpx;
}

.stat-row {
  margin-bottom: 24rpx;
}

.next-task {
  margin: 22rpx 0 4rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid var(--accent);
  border-radius: 0 16rpx 16rpx 0;
  background: #f4f9ff;
}

.next-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 6rpx;
}

.next-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.card .btn {
  margin-top: 22rpx;
}

.rec {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 0;
}

.rec-dot {
  color: var(--accent);
  font-weight: 800;
  line-height: 1.6;
}

.rec-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

.quick {
  display: flex;
  gap: 20rpx;
}

.quick-item {
  flex: 1;
  padding: 26rpx 0;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line-soft);
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}
