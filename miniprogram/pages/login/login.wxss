.login-page {
  padding: 80rpx 40rpx 40rpx;
}

.login-head {
  margin-bottom: 48rpx;
  text-align: center;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 20rpx;
  border-radius: 34rpx 34rpx 34rpx 12rpx;
  background: var(--accent);
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
}

.login-head .muted {
  margin-top: 12rpx;
  padding: 0 20rpx;
}

.login-tip {
  margin-top: 22rpx;
  text-align: center;
  line-height: 1.6;
}
